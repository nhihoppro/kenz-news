<?xml version="1.0" encoding="utf-8"?>
<!-- v3.10: dedicated loading page (SplashActivity, the launcher).
     Full-screen: logo + progress only — no header, no bottom bar,
     no status bar (the activity hides it). The old loading overlay
     on MainActivity is gone with this. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="32dp">
        <ImageView android:id="@+id/imgSplashLogo" android:layout_width="96dp"
            android:layout_height="96dp" android:src="@drawable/ic_logo_full"
            android:layout_gravity="center" android:layout_marginBottom="16dp"
            android:contentDescription="Kenz News" />
        <TextView android:id="@+id/txtSplashTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kenz News" android:textSize="28sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:layout_gravity="center" />
        <TextView android:id="@+id/txtSplashSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tin Mỹ • Video • Xổ số ba miền" android:textSize="14sp"
            android:textColor="#DDE6F5" android:layout_gravity="center"
            android:layout_marginTop="6dp" />
        <ProgressBar android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="240dp" android:layout_height="16dp"
            android:layout_gravity="center" android:layout_marginTop="28dp"
            android:progressDrawable="@drawable/splash_progress"
            android:max="100" android:progress="0" />
        <TextView android:id="@+id/txtSplashStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Đang tải tin mới…" android:textSize="14sp"
            android:textColor="#FFFFFF" android:layout_gravity="center"
            android:layout_marginTop="16dp" />
        <TextView android:id="@+id/txtSplashError"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Không tải được tin mới. Kiểm tra mạng rồi thử lại, hoặc vào app xem tin đã lưu."
            android:textSize="14sp" android:textColor="#FFFFFF"
            android:gravity="center" android:layout_gravity="center"
            android:layout_marginTop="16dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/splashErrorBtns"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_gravity="center"
            android:layout_marginTop="20dp" android:visibility="gone">
            <TextView android:id="@+id/btnSplashRetry"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="Thử lại" android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/chip_glass" android:textColor="#FFFFFF"
                android:gravity="center" android:paddingLeft="20dp" android:paddingRight="20dp"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/btnSplashEnter"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="Vào app" android:textSize="13sp"
                android:background="@drawable/chip_glass" android:textColor="#FFFFFF"
                android:gravity="center" android:paddingLeft="20dp" android:paddingRight="20dp"
                android:layout_marginLeft="12dp"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
