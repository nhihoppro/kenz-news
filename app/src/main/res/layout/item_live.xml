<?xml version="1.0" encoding="utf-8"?>
<!-- v1.25: one LIVE row in the Video tab's live section.
     Background + text colours are set in code (cardBg +
     theme colours, like the state rows) so dark mode stays
     readable; the badge background (red pill) is set in code
     too. Tapping a row opens the in-app player
     (LivePlayerActivity); the player screen itself offers
     "Mở trong app YouTube" as the fallback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp"
    android:gravity="center_vertical">
    <TextView android:id="@+id/txtLiveBadge" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="LIVE"
        android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF"
        android:paddingLeft="6dp" android:paddingRight="6dp"
        android:paddingTop="3dp" android:paddingBottom="3dp" android:gravity="center" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginLeft="10dp">
        <TextView android:id="@+id/txtLiveChannel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtLiveTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="2"
            android:layout_marginTop="2dp" />
        <!-- v1.34: the "tap to watch" hint line is gone on the
             user's order (instructional text cleanup); the card
             tap still opens the player. -->
    </LinearLayout>
</LinearLayout>
