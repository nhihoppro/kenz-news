<?xml version="1.0" encoding="utf-8"?>
<!-- v1.15: half-width grid card (two columns). Header is code + name
     only — the reporting % and the leader now share one short status
     line under the bar, because a half-width card cannot fit the old
     full-width layout (code + name + rep% on one line truncated most
     state names). Name and status are single-line, ellipsized. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingLeft="16dp" android:paddingRight="16dp"
    android:background="@drawable/glass_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtStateCode" android:layout_width="32dp"
            android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#111827" />
        <TextView android:id="@+id/txtStateName" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="#111827" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="6dp"
        android:orientation="horizontal" android:layout_marginTop="4dp"
        android:background="#33FFFFFF">
        <View android:id="@+id/barDem" android:layout_width="0dp"
            android:layout_height="match_parent" android:background="#4874A3" />
        <View android:id="@+id/barRep" android:layout_width="0dp"
            android:layout_height="match_parent" android:background="#C6606B" />
        <View android:id="@+id/barRest" android:layout_width="0dp"
            android:layout_height="match_parent" android:background="#404040" />
    </LinearLayout>
    <TextView android:id="@+id/txtStateLeader" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="#374151" android:layout_marginTop="4dp"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
